+        private static void SendPacket(Socket socket, byte[] data)
+        {
+            int sent = 0;
+            while (sent < data.Length)
+            {
+                int count = socket.Send(data, sent, data.Length - sent, SocketFlags.None,
+                    out var error);
+                if (error != SocketError.Success || count == 0)
+                {
+                    throw new SocketException((int)(error == SocketError.Success
+                        ? SocketError.ConnectionReset : error));
+                }
+
+                sent += count;
             }
         }

