{
  "environments": {
    "analysis": {
      "python": "environments/arx_motion/.venv/bin/python",
      "setup": [
        "uv",
        "sync",
        "--project",
        "environments/arx_motion",
        "--locked",
        "--only-group",
        "handeye",
        "--no-install-project",
        "--python",
        "3.12"
      ]
    },
    "web": {
      "python": "environments/arx_motion/.venv-web/bin/python",
      "setup": [
        "env",
        "UV_PROJECT_ENVIRONMENT=.venv-web",
        "uv",
        "sync",
        "--project",
        "environments/arx_motion",
        "--locked",
        "--only-group",
        "web",
        "--no-install-project",
        "--python",
        "3.12"
      ]
    },
    "rebot": {
      "python": "environments/rebot/.venv/bin/python",
      "setup": [
        "uv",
        "sync",
        "--project",
        "environments/rebot",
        "--locked",
        "--no-install-project",
        "--python",
        "3.10"
      ]
    },
    "phone": {
      "python": "environments/phone/.venv/bin/python",
      "setup": [
        "uv",
        "sync",
        "--project",
        "environments/phone",
        "--locked",
        "--no-install-project",
        "--python",
        "3.12"
      ]
    },
    "frontend": {
      "python": ".venv/bin/python",
      "setup": [
        "npm",
        "ci",
        "--prefix",
        "apps/console",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ]
    },
    "groot": {
      "python": "third_party/Isaac-GR00T/.venv/bin/python",
      "setup": [
        "uv",
        "sync",
        "--project",
        "third_party/Isaac-GR00T",
        "--locked",
        "--python",
        "3.12"
      ],
      "prepare": [
        "python3",
        "scripts/setup/groot_dependency.py"
      ]
    },
    "groot-tensorrt": {
      "python": "third_party/Isaac-GR00T/.venv/bin/python",
      "setup": [
        "uv",
        "sync",
        "--project",
        "third_party/Isaac-GR00T",
        "--locked",
        "--extra",
        "tensorrt",
        "--python",
        "3.12"
      ],
      "prepare": [
        "python3",
        "scripts/setup/groot_dependency.py"
      ]
    }
  },
  "commands": {
    "calibration.payload": {
      "environment": "analysis",
      "module": "legacy.arx_tools.calibrate_payload"
    },
    "calibration.gripper": {
      "environment": "analysis",
      "module": "legacy.arx_tools.calibrate_gripper_guided"
    },
    "motion.console": {
      "environment": "analysis",
      "module": "legacy.arx_tools.control_cli"
    },
    "diagnostic.arm_state": {
      "environment": "analysis",
      "module": "legacy.arx_tools.show_state"
    },
    "diagnostic.d405": {
      "environment": "analysis",
      "module": "legacy.arx_tools.d405_profile_benchmark"
    },
    "gripper.position": {
      "environment": "analysis",
      "module": "legacy.arx_tools.gripper_position_test"
    },
    "gripper.torque": {
      "environment": "analysis",
      "module": "legacy.arx_tools.gripper_force_test"
    },
    "task.cube": {
      "environment": "analysis",
      "module": "legacy.cube"
    },
    "collection.groot": {
      "environment": "web",
      "module": "embodied.data.groot.cli"
    },
    "policy.groot": {
      "environment": "analysis",
      "module": "embodied.policy.groot.cli"
    },
    "ui.backend": {
      "environment": "analysis",
      "module": "embodied.console"
    },
    "camera.rgbd": {
      "environment": "web",
      "module": "embodied.console.features.camera.service"
    },
    "input.hand_service": {
      "environment": "web",
      "module": "embodied.console.features.vision.service"
    },
    "diagnostic.pose_monitor": {
      "environment": "analysis",
      "module": "embodied.phone.tools.pose_monitor"
    },
    "diagnostic.pose_simulator": {
      "environment": "analysis",
      "module": "embodied.phone.tools.pose_simulator"
    },
    "diagnostic.udp_loopback": {
      "environment": "analysis",
      "module": "embodied.phone.tools.udp_loopback"
    },
    "diagnostic.network_test": {
      "environment": "analysis",
      "module": "embodied.phone.tools.network_test"
    },
    "diagnostic.latency_report": {
      "environment": "analysis",
      "module": "embodied.phone.tools.latency_report"
    },
    "diagnostic.control_observations": {
      "environment": "analysis",
      "module": "embodied.phone.tools.control_observations"
    },
    "diagnostic.phone_reset_console": {
      "environment": "analysis",
      "module": "embodied.phone.tools.phase3_mock_session"
    },
    "diagnostic.phase4_kinematics_check": {
      "environment": "analysis",
      "module": "embodied.phone.tools.phase4_kinematics_check"
    },
    "diagnostic.arx5_sdk_inspect": {
      "environment": "analysis",
      "module": "embodied.phone.tools.arx5_sdk_inspect"
    },
    "diagnostic.arx5_state_readiness": {
      "environment": "analysis",
      "module": "embodied.phone.tools.arx5_state_readiness"
    },
    "diagnostic.phase5_motion_preflight": {
      "environment": "analysis",
      "module": "embodied.phone.tools.phase5_motion_preflight"
    },
    "diagnostic.phase5_safety_contract": {
      "environment": "analysis",
      "module": "embodied.phone.tools.phase5_safety_contract"
    },
    "phone.tools": {
      "environment": "phone",
      "module": "embodied.phone.cli"
    },
    "rebot.dm": {
      "environment": "rebot",
      "script": "examples/rebot/0x01damiao_test.py"
    },
    "rebot.rs": {
      "environment": "rebot",
      "script": "examples/rebot/0x01rs06_test.py"
    },
    "rebot.zero": {
      "environment": "rebot",
      "script": "examples/rebot/2_zero_and_read.py"
    },
    "rebot.mit": {
      "environment": "rebot",
      "script": "examples/rebot/3_mit_control.py"
    },
    "rebot.position": {
      "environment": "rebot",
      "script": "examples/rebot/4_pos_vel_control.py"
    },
    "rebot.fk": {
      "environment": "rebot",
      "script": "examples/rebot/5_fk_test.py"
    },
    "rebot.ik": {
      "environment": "rebot",
      "script": "examples/rebot/6_ik_test.py"
    },
    "rebot.endpose": {
      "environment": "rebot",
      "script": "examples/rebot/7_arm_ik_control.py"
    },
    "rebot.trajectory": {
      "environment": "rebot",
      "script": "examples/rebot/8_arm_traj_control.py"
    },
    "rebot.gravity": {
      "environment": "rebot",
      "script": "examples/rebot/9_gravity_compensation.py"
    },
    "rebot.stationary_hold": {
      "environment": "rebot",
      "script": "examples/rebot/10_gravity_compensation_lock.py"
    },
    "viewer.rebot_fk": {
      "environment": "rebot",
      "script": "examples/rebot/sim/fk_sim.py"
    },
    "viewer.rebot_ik": {
      "environment": "rebot",
      "script": "examples/rebot/sim/ik_sim.py"
    },
    "viewer.rebot_trajectory": {
      "environment": "rebot",
      "script": "examples/rebot/sim/traj_sim.py"
    },
    "ui.build": {
      "environment": "frontend",
      "argv": [
        "npm",
        "run",
        "build"
      ],
      "cwd": "apps/console"
    },
    "ui.preview": {
      "environment": "frontend",
      "argv": [
        "npm",
        "run",
        "preview"
      ],
      "cwd": "apps/console"
    },
    "test.motion": {
      "environment": "analysis",
      "module": "pytest",
      "arguments": [
        "tests/motion",
        "-q",
        "--import-mode=importlib"
      ]
    },
    "test.phone": {
      "environment": "analysis",
      "module": "pytest",
      "arguments": [
        "tests/phone",
        "-q",
        "--import-mode=importlib"
      ]
    },
    "ui.console": {
      "environment": "analysis",
      "shell": "src/legacy/arx_tools/web.sh"
    },
    "deployment.lan": {
      "environment": "analysis",
      "shell": "src/legacy/arx_tools/web_lan.sh"
    },
    "deployment.tailnet": {
      "environment": "analysis",
      "shell": "src/legacy/arx_tools/web_tailnet.sh"
    },
    "deployment.restart": {
      "environment": "analysis",
      "shell": "src/legacy/arx_tools/web_restart.sh"
    },
    "diagnostic.can": {
      "environment": "analysis",
      "shell": "src/legacy/arx_tools/can_up.sh"
    },
    "test.rebot": {
      "environment": "rebot",
      "script": "scripts/check_rebot_components.py"
    }
  }
}
