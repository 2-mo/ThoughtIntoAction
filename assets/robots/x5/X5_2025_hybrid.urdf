<?xml version="1.0" encoding="utf-8"?>
<!--
  X5-2025 dynamics merged into Stanford arx5-sdk's X5 model.

  Kinematics, mesh paths, collision geometry, eef_link and useful limits are
  retained from arx5-sdk/models/X5.urdf. Inertial properties come from:
  https://github.com/ARXroboticsX/X5/blob/master/py/arx_x5_python/bimanual/script/x5_2025.urdf
-->
<robot name="X5_2025_hybrid">
  <link name="base_link">
    <inertial>
      <origin xyz="-2.9972E-05 3.056E-05 0.027301" rpy="0 0 0"/>
      <mass value="0.44038"/>
      <inertia ixx="0.00017" ixy="0.00000" ixz="0.00000" iyy="0.00018" iyz="0.00000" izz="0.00016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="./meshes/X5/base_link.STL"/></geometry>
      <material name=""><color rgba="0.75294 0.75294 0.75294 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="./meshes/X5/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.0060953 -0.0042968 0.017959" rpy="0 0 0"/>
      <mass value="0.060835"/>
      <inertia ixx="0.00008" ixy="0.00000" ixz="0.00001" iyy="0.00003" iyz="0.00000" izz="0.00007"/>
