    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="./meshes/X5/link1.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.0603" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link1"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="2.618" effort="30" velocity="5.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="-0.13238 0.0022038 0.00011179" rpy="0 0 0"/>
      <mass value="1.0733"/>
      <inertia ixx="0.00050" ixy="0.00000" ixz="-0.00004" iyy="0.01596" iyz="0.00000" izz="0.01602"/>
