    <parent link="link1"/><child link="link2"/><axis xyz="0 1 0"/>
    <limit lower="-0.05" upper="3.5" effort="40" velocity="5.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0.1872 -0.00030568 -0.051483" rpy="0 0 0"/>
      <mass value="0.4994"/>
      <inertia ixx="0.00033" ixy="-0.00006" ixz="-0.00039" iyy="0.00387" iyz="0.00001" izz="0.00383"/>
